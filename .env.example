# Template only. Run pnpm config:init to generate a private local password.
HELIOS_ENV=development
POSTGRES_DB=helios_dev
POSTGRES_USER=helios
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
DATABASE_URL=postgresql://helios:REPLACE_WITH_GENERATED_PASSWORD@postgres:5432/helios_dev
WEB_PORT=3100
WORKER_ENABLED=true
RESTORE_MODE=false
NEXT_TELEMETRY_DISABLED=1

# Generate locally using pnpm config:auth; do not use this placeholder.
AUTH_SECRET=REPLACE_WITH_64_HEX_RANDOM_CHARACTERS
AUTH_ORIGIN=http://127.0.0.1:3100
# INTEGRATION_KEY is generated locally by pnpm config:integrations (32 random bytes, hex).
