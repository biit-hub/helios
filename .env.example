# Template only. Run pnpm config:init to generate a private local password.
HELIOS_ENV=development
POSTGRES_DB=helios_dev
POSTGRES_USER=helios
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
DATABASE_URL=postgresql://helios:REPLACE_WITH_GENERATED_PASSWORD@postgres:5432/helios_dev
WEB_PORT=3100
WORKER_ENABLED=true
RESTORE_MODE=false
NEXT_TELEMETRY_DISABLED=1

# Generate locally using pnpm config:auth; do not use this placeholder.
AUTH_SECRET=REPLACE_WITH_64_HEX_RANDOM_CHARACTERS
AUTH_ORIGIN=http://127.0.0.1:3100
# INTEGRATION_KEY is generated locally by pnpm config:integrations (32 random bytes, hex).

# Lokaler Kalendertag; bestehende Pläne behalten ihre Zeitzone.
PLAN_TIMEZONE=Europe/Zurich

# Existing private LAN Ollama server; no cloud endpoint, model download or public port.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=90

# Optional TermiHub network policy; credentials are entered encrypted through Helios settings.
TERMIHUB_TIMEOUT_SECONDS=10
TERMIHUB_MAX_RESPONSE_BYTES=2097152
# Comma-separated exact HTTPS origins allowed to resolve to private LAN addresses.
# Empty permits public HTTPS targets only; loopback/metadata remain blocked.
TERMIHUB_PRIVATE_ORIGINS=

# Optional: existing controlled private SearXNG origin; JSON search must be enabled.
# Never set a public instance or include credentials. Empty means research unavailable.
SEARXNG_BASE_URL=
