{
  "name": "helios",
  "version": "0.1.0-dev.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.23.2 || ^24.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @helios/web dev",
    "dev:worker": "pnpm --filter @helios/worker dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @helios/web build && pnpm --filter @helios/worker build",
    "db:generate": "pnpm --filter @helios/backend db:generate",
    "db:migrate": "tsx packages/backend/src/migrate.ts",
    "job:smoke": "tsx apps/worker/src/smoke.ts",
    "config:init": "node scripts/init-env.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "config:auth": "node scripts/init-auth-env.mjs",
    "config:integrations": "node scripts/init-integrations-env.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@playwright/test": "1.64.0",
    "jsdom": "30.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "tsx": "4.23.15",
    "@types/node": "22.19.11",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@helios/backend": "workspace:*",
    "@helios/contracts": "workspace:*",
    "@helios/ui": "workspace:*",
    "drizzle-orm": "0.45.4",
    "prettier": "3.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "otplib": "13.5.0",
    "@types/qrcode": "1.5.6"
  },
  "type": "module"
}
